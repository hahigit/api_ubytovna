{
    "name": "skola/planovac-vyletu",
    "description": "Plánovač výletů – orchestrace API ubytování, atrakcí a počasí",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": { "Planovac\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Planovac\\Tests\\": "tests/" }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:8000 -t public public/index.php",
        "test": "phpunit"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
